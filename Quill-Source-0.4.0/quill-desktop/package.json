{
  "name": "quill-desktop",
  "version": "0.4.0",
  "description": "Local-first document workspace",
  "author": "Vignesh",
  "main": "main.cjs",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=iife --metafile=dist/meta.json --outfile=dist/app.js && node scripts/copy.cjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "package:win": "npm run build && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-color": "^3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-subscript": "^3.32.2",
    "@tiptap/extension-superscript": "^3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-task-item": "3.32.2",
    "@tiptap/extension-task-list": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extension-unique-id": "^3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "diff": "^9.0.0",
    "docx": "^9.15.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "hot-formula-parser": "^4.0.0",
    "jsdom": "^30.1.3",
    "lucide": "^1.66.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "prettier": "^3.9.10",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "build": {
    "appId": "com.vignesh.quill",
    "productName": "Quill",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "store.cjs",
      "!dist/meta.json"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "compression": "normal"
  }
}
